# 複製為 .env 後修改。.env 不會被提交到 Git。
ENVIRONMENT=development
# DATABASE_URL=sqlite:///backend/data/scamcheck.db   # 預設即為此位置；未來可改 PostgreSQL
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 管理員（必填才能登入管理頁）----
# 用 `python -m app.scripts.hash_password` 產生下列兩行
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SECRET_KEY=
ADMIN_TOKEN_MINUTES=120

# ---- Cofacts（留空 = Mock Mode，不查詢、不產生假資料）----
COFACTS_APP_ID=
COFACTS_APP_SECRET=
COFACTS_TIMEOUT_SECONDS=8
COFACTS_MAX_RETRIES=2
COFACTS_DAILY_LIMIT=500

# ---- AI：auto = 有 GEMINI_API_KEY 就使用 Gemini；disabled = 關閉；mock = 示範回應 ----
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_DAILY_LIMIT=300
GEMINI_MAX_INLINE_MB=14

# ---- 上傳限制（開發預設值）----
MAX_TEXT_CHARS=10000
MAX_IMAGE_MB=10
MAX_VIDEO_MB=20
MAX_VIDEO_SECONDS=30
VIDEO_MAX_FRAMES=5

# ---- 頻率限制（每 IP 每分鐘）----
RATE_LIMIT_ANALYZE_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# ---- 研究 ----
RESEARCH_COLLECTION_ENABLED=true
# simulation = 所有研究資料標記 DEMO；formal 須經學校審查與法定代理人同意程序後才可設定
RESEARCH_MODE=simulation
# balanced = 自動平衡 A/B；A 或 B = 整個時段固定同一組（例如整班同一條件）
RESEARCH_GROUP_MODE=balanced
CONSENT_VERSION=2026.10-v0.1

# ---- 保存期限 ----
TEMP_ANALYSIS_RETENTION_HOURS=24
RESEARCH_RETENTION_DAYS=365
